<?xml version="1.0" encoding="utf-8"?>
<!--
  spec.md §1.1: total isolation. CAMERA is the app's only permission.
  Audit: `aapt dump permissions app.apk` must list nothing else.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <!--
      android:allowBackup="false": secrets are memory-only (spec.md §1.2);
      nothing may be serialized into a backup.
    -->
    <application
        android:label="SeedSigner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
